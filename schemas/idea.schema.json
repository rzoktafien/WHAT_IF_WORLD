{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WHAT IF WORLD Idea",
  "type": "object",
  "required": [
    "id",
    "title",
    "pillar",
    "evidence_label",
    "premise",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IDEA-[0-9]{8}-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "pillar": {
      "enum": [
        "EARTH",
        "NATURE & PHYSICS",
        "HUMAN",
        "ECOSYSTEM",
        "CIVILIZATION & TECHNOLOGY"
      ]
    },
    "evidence_label": {
      "enum": [
        "CURRENT_VERIFIED",
        "CURRENT_LIMITED",
        "EVERGREEN",
        "ORIGINAL_EDITORIAL"
      ]
    },
    "premise": {
      "type": "string",
      "minLength": 10
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{3,}$"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CLM-[0-9]{3,}$"
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "SELECTED",
        "REJECTED",
        "DEFERRED"
      ]
    }
  }
}
