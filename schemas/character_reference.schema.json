{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"WHAT IF WORLD Character Reference",
  "type":"object",
  "required":["id","production_id","version","name","owner","created_at","updated_at","status","identity","canonical_reference","wardrobe_variants","rights_status","linked_shots"],
  "properties":{
    "id":{"type":"string","pattern":"^AST-CHAR-[0-9]{3,}$"},
    "production_id":{"type":"string","pattern":"^WW-[0-9]{3,}$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name":{"type":"string","minLength":2},
    "owner":{"type":"string","minLength":2},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "status":{"enum":["DRAFT","REVIEW","APPROVED","SUPERSEDED","REJECTED"]},
    "identity":{"type":"object","required":["face_shape","hair","invariant_traits"],"properties":{
      "face_shape":{"type":"string","minLength":2},"distinctive_features":{"type":"array","items":{"type":"string"}},
      "hair":{"type":"string","minLength":2},"skin_tone":{"type":"string"},"build":{"type":"string"},
      "invariant_traits":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},
      "prohibited_drift":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "canonical_reference":{"type":"object","required":["kind","provenance","creator","source"],"properties":{
      "kind":{"enum":["image","prompt"]},"uri":{"type":["string","null"]},"prompt":{"type":["string","null"]},
      "provenance":{"type":"string","minLength":3},"creator":{"type":"string","minLength":2},"source":{"type":"string","minLength":2},"checksum":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"}},
      "allOf":[{"if":{"properties":{"kind":{"const":"image"}}},"then":{"required":["uri"]}},
               {"if":{"properties":{"kind":{"const":"prompt"}}},"then":{"required":["prompt"]}}]},
    "wardrobe_variants":{"type":"array","items":{"type":"object","required":["variant_id","description"],"properties":{
      "variant_id":{"type":"string","minLength":2},"description":{"type":"string","minLength":2},
      "applicable_shots":{"type":"array","items":{"type":"string","pattern":"^SH-[0-9]{3,}$"}}}}},
    "rights_status":{"enum":["CLEARED","NOT_REQUIRED","PENDING","REJECTED"]},
    "linked_shots":{"type":"array","items":{"type":"string","pattern":"^SH-[0-9]{3,}$"}},
    "approval":{"type":"object","properties":{"by":{"type":["string","null"]},"at":{"type":["string","null"],"format":"date-time"}}}
  },
  "allOf":[{
    "if":{"properties":{"status":{"const":"APPROVED"}},"required":["status"]},
    "then":{"required":["approval"],"properties":{"approval":{"type":"object","required":["by","at"],"properties":{"by":{"type":"string","minLength":1},"at":{"type":"string","format":"date-time"}}}}}
  }],
  "additionalProperties":true
}