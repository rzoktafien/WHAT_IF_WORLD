{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WHAT IF WORLD Edit Timeline",
  "type": "object",
  "required": ["id", "production_id", "version", "status", "frame_rate", "width", "height", "tracks", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^EDL-WW-[0-9]{3,}-v[0-9]+$"},
    "production_id": {"type": "string", "pattern": "^WW-[0-9]{3,}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED", "RENDERED", "REJECTED"]},
    "frame_rate": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "tracks": {"type": "array", "items": {
      "type": "object", "required": ["id", "kind", "clips"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "kind": {"enum": ["VIDEO", "VOICEOVER", "MUSIC", "SFX", "SUBTITLE", "GRAPHICS"]},
        "clips": {"type": "array", "items": {
          "type": "object", "required": ["media_asset_id", "source_in_frame", "source_out_frame", "timeline_start_frame"],
          "properties": {
            "media_asset_id": {"type": "string", "pattern": "^AST-[A-Z]+-[0-9]{3,}$"},
            "source_in_frame": {"type": "integer", "minimum": 0},
            "source_out_frame": {"type": "integer", "minimum": 1},
            "timeline_start_frame": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }}
      },
      "additionalProperties": false
    }},
    "created_at": {"type": "string", "format": "date-time"},
    "render_profile": {"type": ["object", "null"]},
    "rendered_master_asset_id": {"type": ["string", "null"], "pattern": "^AST-MASTER-[0-9]{3,}$"}
  },
  "additionalProperties": false
}